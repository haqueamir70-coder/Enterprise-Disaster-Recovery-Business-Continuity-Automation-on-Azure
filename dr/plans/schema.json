{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic BCDR Recovery Plan",
  "type": "object",
  "required": ["plan_name", "primary_region", "recovery_region", "exercise_type", "workloads"],
  "properties": {
    "plan_name": {"type": "string", "minLength": 1},
    "primary_region": {"type": "string", "minLength": 1},
    "recovery_region": {"type": "string", "minLength": 1},
    "exercise_type": {
      "enum": ["tabletop", "test-failover", "planned-failover", "unplanned-failover", "failback"]
    },
    "workloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name", "tier", "rto_minutes", "rpo_minutes", "dependencies",
          "recovery_order", "recovery_method"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "tier": {"enum": ["tier-0", "tier-1", "tier-2", "tier-3"]},
          "rto_minutes": {"type": "integer", "minimum": 1},
          "rpo_minutes": {"type": "integer", "minimum": 0},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "recovery_order": {"type": "integer", "minimum": 1},
          "recovery_method": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
